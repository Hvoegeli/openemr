# Copy this file to .env and fill in the secrets.
# .env is gitignored; .env.example is checked in.

# ─── LLM ──────────────────────────────────────────────────────────────────
# Provider: "anthropic" (direct API, default) or "bedrock" (AWS Bedrock).
# Bedrock is required for HIPAA-grade deployments because Anthropic only
# offers a Business Associate Agreement via Bedrock, not via the direct API.
LLM_PROVIDER=anthropic

# Anthropic-direct path
ANTHROPIC_API_KEY=sk-ant-...

# AWS Bedrock path — only consulted when LLM_PROVIDER=bedrock. AWS
# credentials are read from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# (or ~/.aws/credentials, or an IAM role) by boto3 — we don't read them
# here.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ─── Observability ────────────────────────────────────────────────────────
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent_forge

# ─── OpenEMR FHIR ─────────────────────────────────────────────────────────
OPENEMR_FHIR_BASE_URL=https://localhost:9300/apis/default/fhir
OPENEMR_OAUTH_TOKEN_URL=https://localhost:9300/oauth2/default/token
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=

# Seed/password-grant client (used for both demo-data seeding and validating
# user logins against OpenEMR). Run scripts/register_seed_client.py to create.
OPENEMR_SEED_CLIENT_ID=
OPENEMR_SEED_CLIENT_SECRET=

# ─── Co-pilot cookie sessions ─────────────────────────────────────────────
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
COPILOT_SESSION_SECRET=

# ─── App database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agent_forge:dev@localhost:5432/agent_forge
