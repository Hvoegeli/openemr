# Copy this file to .env and fill in the secrets.
# .env is gitignored; .env.example is checked in.

# ─── LLM ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Observability ────────────────────────────────────────────────────────
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent_forge

# ─── OpenEMR FHIR ─────────────────────────────────────────────────────────
OPENEMR_FHIR_BASE_URL=https://localhost:9300/apis/default/fhir
OPENEMR_OAUTH_TOKEN_URL=https://localhost:9300/oauth2/default/token
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=

# ─── App database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agent_forge:dev@localhost:5432/agent_forge
